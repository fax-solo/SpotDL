{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/AGENTS.md"],
  "mcp": {
    "gcloud": {
      "type": "local",
      "command": ["npx", "-y", "@google-cloud/gcloud-mcp"],
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://bindings.mcp.cloudflare.com/mcp"],
      "enabled": true
    },
    "cloudflare-observability": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://observability.mcp.cloudflare.com/mcp"],
      "enabled": true
    },
    "cloudflare-builds": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://builds.mcp.cloudflare.com/mcp"],
      "enabled": true
    }
  }
}
