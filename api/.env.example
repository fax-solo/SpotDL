# REQUIRED: Spotify API credentials (get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Spotify OAuth redirect URI — must match Spotify Dev Dashboard
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/spotify/callback

# Frontend URL (for OAuth callback redirect)
CLIENT_URL=http://localhost:5173

# OPTIONAL: API key for protecting download/sync endpoints
# Clients must send Authorization: Bearer <key> header
SPOTDL_API_KEY=your-secure-api-key

# OPTIONAL: Encrypt stored OAuth tokens at rest
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTDL_TOKEN_ENCRYPTION_KEY=

# OPTIONAL: Enable /api/debug/auth endpoint (set to "true" to enable)
SPOTDL_DEBUG=false

# OPTIONAL: Concurrent download limit
SPOTDL_CONCURRENT_DOWNLOADS=4

# OPTIONAL: Metadata cache TTL in seconds
SPOTDL_CACHE_TTL=300
