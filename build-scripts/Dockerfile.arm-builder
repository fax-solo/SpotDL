FROM ubuntu:22.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential \
    curl \
    wget \
    unzip \
    zip \
    git \
    python3 \
    python3-pip \
    openssl \
    libssl-dev \
    zlib1g-dev \
    libncurses5-dev \
    libgdbm-dev \
    libnss3-dev \
    libreadline-dev \
    libffi-dev \
    libsqlite3-dev \
    libbz2-dev \
    pkg-config \
    file \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY build-android-binaries.sh /build/
RUN chmod +x /build/build-android-binaries.sh

CMD ["/build/build-android-binaries.sh"]
