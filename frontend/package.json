{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,vite,func -c green,cyan,yellow '../api/venv/bin/uvicorn index:app --app-dir ../api --host 0.0.0.0 --port 8000 --reload' 'vite --host' 'node dev-server.mjs'",
    "dev:api": "../api/venv/bin/uvicorn index:app --app-dir ../api --host 0.0.0.0 --port 8000 --reload",
    "dev:server": "node dev-server.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:deploy": "wrangler pages deploy dist --project-name=spotify-downloader"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-app-update": "^8.0.0",
    "@capawesome/capacitor-background-task": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.0",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@tailwindcss/vite": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "browser-id3-writer": "^6.3.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  }
}
